# ─── Core ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
# Allowed browser origins (CORS), comma-separated. In production set this to your
# deployed frontend URL, e.g. CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Web client ID from Google Cloud Console → Credentials → OAuth client ID.
# Used to verify Google ID tokens. The SAME id goes in the frontend env.
GOOGLE_CLIENT_ID=

# ─── Database (Postgres + pgvector) ──────────────────────────────────────────
# Inside docker-compose these hostnames resolve to the service names.
DATABASE_URL=postgresql+asyncpg://outreach:outreach@localhost:5432/outreach_scout

# ─── Redis (cache + ARQ job queue) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Provider: "openai" (OpenAI-compatible: Groq / Gemini / OpenRouter / Ollama)
#           or "anthropic" (Claude).
LLM_PROVIDER=openai

# ── FREE default: Groq ──  Get a free key (no card) at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_CHEAP=llama-3.1-8b-instant
# PREMIUM drives the ReAct tool-calling loop + final draft. openai/gpt-oss-120b is Groq's
# best production agentic model (native tools + JSON-schema). Lighter: llama-3.3-70b-versatile.
LLM_MODEL_PREMIUM=openai/gpt-oss-120b

# ── Other free OpenAI-compatible options (swap the three values above) ──
#  Google Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  CHEAP=gemini-2.5-flash-lite PREMIUM=gemini-2.5-flash (2.0 may be 0-quota)
#                  AIza… key from https://aistudio.google.com/apikey
#  OpenRouter    : LLM_BASE_URL=https://openrouter.ai/api/v1  · use a ":free" model
#  Ollama (local): LLM_BASE_URL=http://localhost:11434/v1 · LLM_API_KEY=ollama
#                  LLM_MODEL_*=llama3.1  (no key/cost; needs `ollama pull llama3.1`)

# Only used when LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=

# ─── Observability (Langfuse) ────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Agent budget caps (per lead) ────────────────────────────────────────────
AGENT_MAX_STEPS=12
AGENT_TOKEN_BUDGET=120000
AGENT_MAX_COST_USD=0.50

# ─── External data tool APIs ──────────────────────────────────────────────────
# Web search: leave TAVILY_API_KEY blank to use keyless DuckDuckGo (free).
# Tavily free tier (1,000/mo, no card): https://tavily.com
TAVILY_API_KEY=
# fetch_page needs no key (it just fetches + parses HTML).
#
# OPTIONAL paid enrichment — leave blank to run free. When blank, these tools are
# not offered to the agent and it enriches via web_search + fetch_page instead.
CRUNCHBASE_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
BUILTWITH_API_KEY=

# ─── CRM sync (optional) ──────────────────────────────────────────────────────
# Leave blank to use the free LogConnector (records what would sync). Set a
# HubSpot private-app token to push approved leads to HubSpot for real.
HUBSPOT_ACCESS_TOKEN=

# ─── Tool layer behaviour ────────────────────────────────────────────────────
TOOL_DEFAULT_TIMEOUT_SECONDS=20
TOOL_MAX_RETRIES=3
TOOL_CACHE_TTL_SECONDS=86400
